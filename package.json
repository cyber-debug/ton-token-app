  "private": true,
  "type": "module",
  "dependencies": {
    "@ton/core": "^0.60.1",
    "@tonconnect/ui-react": "^2.0.12",
    "buffer": "^6.0.3",
    "chart.js": "^4.4.8",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
